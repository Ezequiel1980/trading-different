{
  "version": 2,
  "name": "trading-different",
  "builds": [
    { "src": "index.html",   "use": "@vercel/static" },
    { "src": "heatmap.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/heatmap", "dest": "/heatmap.html" },
    { "src": "/(.*)",    "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
