{
  "version": 2,
  "name": "trading-different",
  "builds": [
    { "src": "index.html",    "use": "@vercel/static" },
    { "src": "heatmap.html",  "use": "@vercel/static" },
    { "src": "api/*.py",      "use": "@vercel/python" },
    { "src": "api/cron/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/sync",             "dest": "/api/sync.py" },
    { "src": "/api/webhook",          "dest": "/api/webhook.py" },
    { "src": "/api/alert",            "dest": "/api/alert.py" },
    { "src": "/api/cron/check",       "dest": "/api/cron/check.py" },
    { "src": "/api/cron/briefing",    "dest": "/api/cron/briefing.py" },
    { "src": "/heatmap",              "dest": "/heatmap.html" },
    { "src": "/(.*)",                 "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/check",    "schedule": "*/5 * * * *" },
    { "path": "/api/cron/briefing", "schedule": "0 11 * * *"  }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=60" }
      ]
    }
  ]
}
